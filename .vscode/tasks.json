{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "linux-debug"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "build-debug", "--", "-j"],
      "dependsOn": "CMake Configure Debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run EFramework",
      "type": "shell",
      "command": "${workspaceFolder}/build/debug/eframework",
      "dependsOn": "CMake Build Debug",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
