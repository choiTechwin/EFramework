{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug EFramework with GDB",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/eframework",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "DISPLAY", "value": "${env:DISPLAY}" },
        { "name": "WAYLAND_DISPLAY", "value": "${env:WAYLAND_DISPLAY}" },
        { "name": "XDG_RUNTIME_DIR", "value": "${env:XDG_RUNTIME_DIR}" }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake Build Debug",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for GDB",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}