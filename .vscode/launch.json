{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "EFramework (WSL GCC Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_wsl/bin/EFramework",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "preLaunchTask": "WSL: Build and Run",
            "linux": {
                "MIMode": "gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            },
            "osx": {
                "MIMode": "lldb"
            },
            "windows": {
                "MIMode": "gdb"
            }
        },
        {
            "name": "EFramework (WSL Run Only)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_wsl/bin/EFramework",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "preLaunchTask": "WSL: Build Debug"
        }
    ]
